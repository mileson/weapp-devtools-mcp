# Required when connecting to an already-running WeChat DevTools automation service.
WEAPP_WS_ENDPOINT=ws://localhost:9420

# Optional connection mode: connect or launch.
WEAPP_AUTOMATOR_MODE=connect

# Optional DevTools launch account and ticket for controlled local launch flows.
WEAPP_AUTO_ACCOUNT=
WEAPP_DEVTOOLS_TICKET=

# Optional local project path. Do not commit a real team/private path in project docs.
WEAPP_PROJECT_PATH=/path/to/your/project

# Optional WeChat DevTools CLI path.
WECHAT_DEVTOOLS_CLI_PATH=/Applications/wechatwebdevtools.app/Contents/MacOS/cli

# Optional automation port and timeouts.
WEAPP_DEVTOOLS_PORT=9420
WEAPP_DEVTOOLS_TIMEOUT=30000
WEAPP_LAUNCH_TIMEOUT=45000
WEAPP_CONNECT_TIMEOUT=45000

# Optional auto-launch controls.
WEAPP_AUTOLAUNCH=false
WEAPP_AUTOCLOSE=false
WEAPP_TRUST_PROJECT=false
WEAPP_DEVTOOLS_CWD=/path/to/working/directory
WEAPP_DEVTOOLS_ARGS=

# Optional privacy escape hatches. Keep these disabled unless the local session is trusted.
WEAPP_ALLOW_INLINE_SCREENSHOT=false
WEAPP_ALLOW_HIGH_RISK_WX=false
WEAPP_ALLOWED_WX_METHODS=
WEAPP_BLOCKED_WX_METHODS=
WEAPP_ALLOW_RISKY_TOOLS=false
WEAPP_ALLOW_EVALUATE=false
WEAPP_ALLOW_MOCK_WX=false
WEAPP_ALLOW_CLI_COMMANDS=false
WEAPP_ALLOW_SENSITIVE_OUTPUT=false
WEAPP_MASK_INPUT_VALUES=true

# Optional tool surface controls.
WEAPP_TOOLS_PROFILE=full
WEAPP_ENABLE_TOOL_CATEGORIES=
WEAPP_DISABLE_TOOL_CATEGORIES=
WEAPP_ENABLE_TOOLS=
WEAPP_DISABLE_TOOLS=

# Optional network monitoring controls.
WEAPP_ENABLE_NETWORK_MONITORING=true
WEAPP_MAX_NETWORK_LOGS=1000

# Optional output limits.
WEAPP_MAX_OUTPUT_CHARS=50000
WEAPP_MAX_STRING_CHARS=4000
WEAPP_MAX_ARRAY_ITEMS=80
WEAPP_MAX_OBJECT_KEYS=120
